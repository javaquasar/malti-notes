    {
      "id": "lesson05-command-advice",
      "title": "Advice and commands",
      "itemType": "example",
      "provenance": "MQF 2 · Lesson 05, Lesson 05 - Material Analysis.md · imperattiv 1 and imperattiv 3 and 4",
      "items": [
        {
          "slug": "lesson05-command-advice-1",
          "maltese": "Jekk trid titgħallem, ifhem malajr.",
          "english": "If you want to learn, grasp things quickly."
        },
        {
          "slug": "lesson05-command-advice-2",
          "maltese": "Biex tifhem malajr, oqgħod attent.",
          "english": "To understand quickly, pay attention."
        },
        {
          "slug": "lesson05-command-advice-3",
          "maltese": "Biex jagħżlek il-kowċ, ilgħab sew.",
          "english": "Play well so that the coach picks you."
        },
        {
          "slug": "lesson05-command-advice-4",
          "maltese": "Meta toħroġ fix-xemx, għatti rasek sew bil-kappell.",
          "english": "When you go out in the sun, cover your head well with your hat."
        },
        {
          "slug": "lesson05-command-advice-5",
          "maltese": "Ħawwel dawk ix-xtieli qabel jidbielu.",
          "english": "Plant those seedlings before they wilt."
        },
        {
          "slug": "lesson05-command-advice-6",
          "maltese": "Ħobb lil ommok għax ma ssibx oħra bħalha.",
          "english": "Love your mother, because you won't find another like her."
        },
        {
          "slug": "lesson05-command-advice-7",
          "maltese": "Fakkar ftit lil oħtok biex tagħmel ix-xirja.",
          "english": "Remind your sister to do the shopping."
        },
        {
          "slug": "lesson05-command-advice-8",
          "maltese": "“Aħsel il-platti,” ordnat l-omm lil bintha.",
          "english": "“Wash the dishes,” the mother told her daughter."
        },
        {
          "slug": "lesson05-command-advice-9",
          "maltese": "“Iftħu l-bieb għax xi ħadd qiegħed iħabbat,” ordna l-missier lil uliedu.",
          "english": "“Open the door because someone is knocking,” the father told his children."
        },
        {
          "slug": "lesson05-command-advice-10",
          "maltese": "“Ilagħbu sew għax inwaqqaf il-logħba,” qal il-kowċ.",
          "english": "“Play properly or I'll stop the game,” the coach said."
        },
        {
          "slug": "lesson05-command-advice-11",
          "maltese": "“Ibqa' ftit hawn ħa nkellmek,” qaltli l-ġara.",
          "english": "“Stay here a little so I can talk to you,” the neighbour told me."
        },
        {
          "slug": "lesson05-command-advice-12",
          "maltese": "“Agħlaq it-tieqa għax dieħel id-dubbien,” qalet Rita.",
          "english": "“Close the window because flies are getting in,” Rita said."
        }
      ]
    },
