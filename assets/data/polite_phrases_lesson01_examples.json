    {
      "id": "greeting-situations",
      "title": "Choose the expression",
      "itemType": "questionAnswer",
      "items": [
        {
          "slug": "greeting-situations-1",
          "question": {
            "maltese": "Din tgħidha lil xi ħadd biex tawguralu s-serata t-tajba.",
            "english": "You say this to wish someone a good evening."
          },
          "answer": {
            "maltese": "Bonswa.",
            "english": "Good evening."
          },
          "note": "Answer (d). The final repeated (g) in the handout is labelled (h) here."
        },
        {
          "slug": "greeting-situations-2",
          "question": {
            "maltese": "Din tgħidha biex tirringrazzja lil xi ħadd.",
            "english": "You say this to thank someone."
          },
          "answer": {
            "maltese": "Grazzi.",
            "english": "Thank you."
          },
          "note": "Answer (e). The final repeated (g) in the handout is labelled (h) here."
        },
        {
          "slug": "greeting-situations-3",
          "question": {
            "maltese": "Din it-tislima nużawha meta nilmħu lil xi ħadd li nafu filgħodu.",
            "english": "We use this greeting when we see someone we know in the morning."
          },
          "answer": {
            "maltese": "Bonġu.",
            "english": "Good morning."
          },
          "note": "Answer (f). The final repeated (g) in the handout is labelled (h) here."
        },
        {
          "slug": "greeting-situations-4",
          "question": {
            "maltese": "Din tgħidha biex titlob lil xi ħadd jgħidlek jew jagħtik xi ħaġa.",
            "english": "You say this to ask someone to tell you or give you something."
          },
          "answer": {
            "maltese": "Jekk jogħġbok.",
            "english": "Please."
          },
          "note": "Answer (a). The final repeated (g) in the handout is labelled (h) here."
        },
        {
          "slug": "greeting-situations-5",
          "question": {
            "maltese": "Din tgħidha meta titlob il-barka ta' xi ħadd.",
            "english": "You say this when asking someone for their blessing."
          },
          "answer": {
            "maltese": "Bezzjoni.",
            "english": "Your blessing, please."
          },
          "note": "Answer (b). The final repeated (g) in the handout is labelled (h) here."
        },
        {
          "slug": "greeting-situations-6",
          "question": {
            "maltese": "Din tgħidha biex tawgura lil xi ħadd lejl tajjeb.",
            "english": "You say this to wish someone a good night."
          },
          "answer": {
            "maltese": "Il-lejl it-tajjeb.",
            "english": "Good night."
          },
          "note": "Answer (g). The final repeated (g) in the handout is labelled (h) here."
        },
        {
          "slug": "greeting-situations-7",
          "question": {
            "maltese": "Din tgħidha bħala risposta wara li xi ħadd ikun irringrazzjak.",
            "english": "You say this in reply after someone has thanked you."
          },
          "answer": {
            "maltese": "M'hemmx imniex.",
            "english": "You are welcome."
          },
          "note": "Answer (ċ). The final repeated (g) in the handout is labelled (h) here."
        },
        {
          "slug": "greeting-situations-8",
          "question": {
            "maltese": "Din tgħidha meta tkun se tinfired minn ma' xi ħadd.",
            "english": "You say this when you are about to part from someone."
          },
          "answer": {
            "maltese": "Saħħa.",
            "english": "Bye."
          },
          "note": "Answer (h). The final repeated (g) in the handout is labelled (h) here."
        }
      ],
