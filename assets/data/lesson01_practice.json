  "contrasts": [
    {
      "title": "Narak / Narawk",
      "text": "Narak: I will see you (one person). Narawk: we will see you (one person). Narakom / Narawkom address several people. Do not confuse the number of speakers with the number of listeners."
    },
    {
      "title": "Tajjeb / Tajba",
      "text": "A male speaker says Tajjeb, grazzi; a female speaker says Tajba, grazzi. In greetings the adjective agrees with the noun: lejl (masculine), lejla (feminine)."
    },
    {
      "title": "Lejl / Lejla",
      "text": "Il-lejl it-tajjeb: good night, usually a farewell or bedtime wish. Il-lejla t-tajba: good evening, a greeting."
    },
    {
      "title": "Everyday / Occasional",
      "text": "Bonġu, grazzi and saħħa are everyday priorities. Birthday wishes belong to an occasion. Bezzjoni is a traditional request for a blessing, not a general greeting."
    }
  ],
