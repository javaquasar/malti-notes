  "lesson23": {
    "buildSteps": [
      {
        "title": "Start from the present tense",
        "text": "Use the second-person present forms first. That keeps the command pattern easy to spot in both singular and plural."
      },
      {
        "title": "Drop the first conjugating letter",
        "text": "For many common verbs, remove the first conjugating letter from the present form and you get the imperative."
      },
      {
        "title": "Keep singular and plural side by side",
        "text": "Think in pairs: `inti` gives the singular command and `intom` gives the plural command."
      }
    ],
    "buildExamples": [
      {
