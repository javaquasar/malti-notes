      "id": "gender-rules", "title": "Core gender patterns", "itemType": "rule", "cardClass": "pattern-card", "containerClass": "stack",
      "items": [
        { "slug": "learn-pairs", "title": "Learn the noun with its gender", "rule": "Maltese distinguishes masculine and feminine grammatical gender. Many feminine forms end in -a, but an ending alone is not a reliable rule for every noun.", "pattern": "kelb / kelba; missier / omm" },
        { "slug": "not-append-a", "title": "A suffix is not the whole rule", "rule": "Some pairs add -a, some change the stem, and others use different words. Learn the full pair instead of using an automatic add-a conversion.", "pattern": "qattus / qattusa; armel / armla; raġel / mara" },
        { "slug": "agreement", "title": "Follow the noun through the sentence", "rule": "Demonstratives, adjectives and relevant verb forms agree with their referent. Check the complete sentence, not just the replacement noun.", "pattern": "Dan hu l-papà. / Din hi l-mamà." },
        { "slug": "number", "title": "Number matters too", "rule": "An adjective can have masculine singular, feminine singular and plural forms. A feminine form is not automatically a plural form.", "pattern": "ktieb ġdid / karozza ġdida / kotba ġodda" }
      ]
