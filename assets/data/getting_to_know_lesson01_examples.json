    {
      "id": "marija-pawlu",
      "title": "Marija and Pawlu: complete dialogue",
      "itemType": "example",
      "items": [
        {
          "slug": "marija-pawlu-1",
          "maltese": "Marija: Bonġu! Jien Marija. Kif jismek?",
          "english": "Marija: Hello! I am Marija. What is your name?",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-2",
          "maltese": "Pawlu: Bonġu! Jien Pawlu. Għandi pjaċir niltaqa' miegħek.",
          "english": "Pawlu: Hello! I am Pawlu. Pleased to meet you.",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-3",
          "maltese": "Marija: Għandi pjaċir ukoll. Minn fejn int, Pawlu?",
          "english": "Marija: Pleased to meet you too. Where are you from, Pawlu?",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-4",
          "maltese": "Pawlu: Jien minn Ħaż-Żabbar. U int?",
          "english": "Pawlu: I am from Żabbar. And you?",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-5",
          "maltese": "Marija: Jien mill-Mosta. X'tagħmel fil-ħajja?",
          "english": "Marija: I am from Mosta. What do you do for a living?",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-6",
          "maltese": "Pawlu: Naħdem bħala għalliem fi skola sekondarja. U int?",
          "english": "Pawlu: I work as a teacher in a secondary school. And you?",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-7",
          "maltese": "Marija: Jien naħdem f'uffiċċju bħala segretarja.",
          "english": "Marija: I work in an office as a secretary.",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-8",
          "maltese": "Pawlu: Interessanti! X'tħobb tagħmel fil-ħin liberu tiegħek?",
          "english": "Pawlu: Interesting! What do you like doing in your free time?",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-9",
          "maltese": "Marija: Inħobb naqra kotba, nisma' l-mużika u mmur mixjiet. U int?",
          "english": "Marija: I like reading books, listening to music and going for walks. And you?",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-10",
          "maltese": "Pawlu: Jien inħobb insajjar u nivvjaġġa.",
          "english": "Pawlu: I like cooking and travelling.",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-11",
          "maltese": "Marija: Kien sabiħ li ltqajt miegħek, Pawlu.",
          "english": "Marija: It was nice meeting you, Pawlu.",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-12",
          "maltese": "Pawlu: Grazzi! Nispera li nerġgħu niltaqgħu. Saħħa!",
          "english": "Pawlu: Thank you! I hope we meet again. Bye!",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        },
        {
          "slug": "marija-pawlu-13",
          "maltese": "Marija: Saħħa!",
          "english": "Marija: Bye!",
          "source": {
            "kind": "site",
            "page": "getting_to_know.html"
          }
        }
      ]
    },
