        { "slug": "ma-tatx-kas", "maltese": "Hi ma tatx kas.", "english": "She did not pay attention.", "note": "The same female subject; ma tatx kas is the negative of tat kas." },
        { "slug": "intebhet", "maltese": "Hi intebħet li l-bieb kien miftuħ.", "english": "She noticed that the door was open.", "note": "Intebħet refers to her noticing or realising something, not merely hearing a sound." },
        { "slug": "qorbot", "maltese": "Hi qorbot lejn il-bieb.", "english": "She approached the door.", "note": "Hi is the woman moving closer; lejn il-bieb identifies what she approached." },
        { "slug": "mohhha-fil-girien", "maltese": "Hi dejjem moħħha fil-ġirien.", "english": "She is always preoccupied with the neighbours.", "note": "The suffix -ha in moħħha means 'her': her attention is on the neighbours. This is figurative, not a physical location of her mind." },
