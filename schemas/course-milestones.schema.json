{
  "$id": "https://malti-notes.local/schemas/course-milestones.schema.json",
  "type": "object",
  "required": ["schemaVersion", "description", "sets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "sets": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "passPercent", "chapterIds", "chapterCount", "targetCount", "itemCount", "modeCounts", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^course-milestone-" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "const": "milestone" },
          "passPercent": { "type": "integer", "minimum": 1, "maximum": 100 },
          "chapterIds": { "type": "array", "minItems": 7, "items": { "type": "string" }, "uniqueItems": true },
          "chapterCount": { "type": "integer", "minimum": 7 },
          "targetCount": { "type": "integer", "minimum": 1 },
          "itemCount": { "const": 28 },
          "modeCounts": {
            "type": "object",
            "required": ["recognition", "production"],
            "additionalProperties": false,
            "properties": { "recognition": { "const": 14 }, "production": { "const": 14 } }
          },
          "items": {
            "type": "array",
            "minItems": 28,
            "maxItems": 28,
            "items": {
              "type": "object",
              "required": ["id", "type", "assessmentMode", "prompt", "targetIds", "sourceAssessmentId", "sourceChapterId"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "type": { "enum": ["multiple-choice", "true-false", "fill-blank", "order-words"] },
                "assessmentMode": { "enum": ["recognition", "production"] },
                "prompt": { "type": "string", "minLength": 1 },
                "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "sourceAssessmentId": { "type": "string", "minLength": 1 },
                "sourceChapterId": { "type": "string", "pattern": "^b[12]-" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
