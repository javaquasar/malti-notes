{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Numbers expansion with source coverage",
  "type": "object",
  "required": ["schemaVersion", "sections", "questions", "coverage", "sourceUnits", "materials", "editorialNotes", "references"],
  "properties": {
    "schemaVersion": {"const": 1},
    "translationLanguage": {"const": "en"},
    "sections": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "kind", "maltese", "english", "sourceRefs"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "maltese": {"type": "string"},
            "english": {"type": "string"},
            "sourceRefs": {"type": "array"}
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 77,
      "items": {
        "type": "object",
        "required": ["id", "topic", "prompt", "answer", "accepted", "options", "sourceRefs", "explanation"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "accepted": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "options": {"type": "array", "items": {"type": "string"}},
          "sourceRefs": {"type": "array", "minItems": 1},
          "explanation": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage": {"type": "array", "minItems": 205, "items": {"type": "object", "required": ["sourceItemId", "section", "disposition", "sourceRefs"]}},
    "sourceUnits": {"type": "array", "minItems": 129},
    "materials": {"type": "array", "minItems": 13},
    "editorialNotes": {"type": "array", "items": {"type": "object", "required": ["code", "resolution"]}},
    "references": {"type": "array", "items": {"type": "object", "required": ["id", "title", "url"]}}
  }
}
