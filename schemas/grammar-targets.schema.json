{
  "$id": "https://malti-notes.local/schemas/grammar-targets.schema.json",
  "type": "object",
  "required": ["schemaVersion", "page", "title", "description", "targets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "page": { "const": "grammar_path.html" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["kind", "coverageStatus"],
      "properties": {
        "kind": { "enum": ["book-grammar-topic", "site-extension"] },
        "inventoryTopicIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "sourcePage": { "type": "string", "pattern": "\\.html$" },
        "coverageStatus": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "book-grammar-topic" } } },
          "then": { "required": ["inventoryTopicIds"] },
          "else": { "required": ["sourcePage"] }
        }
      ]
    },
    "example": {
      "type": "object",
      "required": ["id", "maltese", "english", "note"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "maltese": { "type": "string", "minLength": 1 },
        "english": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "assessmentItem": {
      "type": "object",
      "required": ["type", "prompt", "answer", "explanation"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["multiple-choice", "fill-blank"] },
        "prompt": { "type": "string", "minLength": 1 },
        "choices": { "type": "array", "minItems": 3, "items": { "type": "string" }, "uniqueItems": true },
        "answer": { "type": "string", "minLength": 1 },
        "accepted": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "required": ["id", "book", "chapterId", "title", "sourceRequirement", "role", "summary", "rule", "pattern", "commonMistake", "sourceRef", "examples", "masteryLabel", "assessment"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^grammar-" },
        "book": { "enum": ["B1", "B2"] },
        "chapterId": { "type": "string", "pattern": "^b[12]-" },
        "title": { "type": "string", "minLength": 1 },
        "sourceRequirement": { "type": "string", "minLength": 1 },
        "role": { "enum": ["core", "supporting"] },
        "summary": { "type": "string", "minLength": 1 },
        "rule": { "type": "string", "minLength": 1 },
        "pattern": { "type": "string", "minLength": 1 },
        "commonMistake": { "type": "string", "minLength": 1 },
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "examples": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/example" } },
        "masteryLabel": { "type": "string", "minLength": 1 },
        "assessment": {
          "type": "object",
          "required": ["recognition", "production"],
          "additionalProperties": false,
          "properties": {
            "recognition": { "$ref": "#/$defs/assessmentItem" },
            "production": { "$ref": "#/$defs/assessmentItem" }
          }
        }
      }
    }
  }
}
