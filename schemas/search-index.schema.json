{
  "$id": "https://malti-notes.local/schemas/search-index.schema.json",
  "type": "object",
  "required": ["schemaVersion", "description", "entryCount", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "description": { "type": "string", "minLength": 1 },
    "entryCount": { "type": "integer", "minimum": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "title", "subtitle", "group", "href", "find", "normalized"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["page", "word", "phrase", "verb"] },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string" },
          "group": { "type": "string" },
          "href": { "type": "string", "pattern": "\\.html$" },
          "find": { "type": "string" },
          "normalized": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
