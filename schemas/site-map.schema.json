{
  "$id": "https://malti-notes.local/schemas/site-map.schema.json",
  "type": "object",
  "required": ["standalone", "groups"],
  "additionalProperties": false,
  "properties": {
    "standalone": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "heading", "pages"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "heading": { "type": "string", "minLength": 1 },
          "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
        }
      }
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["href", "label", "description"],
      "additionalProperties": false,
      "properties": {
        "href": { "type": "string", "pattern": "^[^/]+\\.html$" },
        "label": { "type": "string", "minLength": 1 },
        "navLabel": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "featured": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
