{
  "name": "malti-notes",
  "version": "1.0.0",
  "description": "Static Maltese study notes and review pages.",
  "scripts": {
    "ci:workflow:check": "node ./scripts/ci_workflow_check.js",
    "pwa:build": "node ./scripts/build_service_worker.js",
    "pwa:check": "node ./scripts/build_service_worker.js --check",
    "visual:smoke": "node ./scripts/visual_smoke_check.js",
    "visual:screenshots": "node ./scripts/visual_screenshots.js",
    "visual:ci": "node ./scripts/visual_ci_check.js",
    "visual:diff": "node ./scripts/visual_diff.js",
    "visual:baseline": "node ./scripts/visual_baseline.js",
    "visual:diff:baseline": "node ./scripts/visual_diff.js --baseline visual-regression/baseline",
    "visual:groups": "node ./scripts/framed_group_visual_check.js",
    "visual:groups:update": "node ./scripts/framed_group_visual_check.js --update",
    "theme:a11y": "node ./scripts/theme_accessibility_check.js",
    "style:lint": "node ./scripts/style_lint.js",
    "data:lint": "node ./scripts/data_lint.js",
    "content:lint": "node ./scripts/content_lint.js",
    "books:coverage": "node ./scripts/book_coverage_check.js",
    "course:bindings:build": "node ./scripts/build_course_target_bindings.js",
    "course:bindings:check": "node ./scripts/build_course_target_bindings.js --check",
    "course:assessments:build": "node ./scripts/build_course_target_assessments.js",
    "course:assessments:check": "node ./scripts/build_course_target_assessments.js --check",
    "course:supplements:build": "node ./scripts/build_course_supplemental_content.js",
    "course:supplements:check": "node ./scripts/build_course_supplemental_content.js --check",
    "course:verbs:build": "node ./scripts/build_course_verb_paradigms.js",
    "course:verbs:check": "node ./scripts/build_course_verb_paradigms.js --check",
    "course:examples:build": "node ./scripts/build_course_contextual_examples.js && npm run course:supplements:build",
    "course:examples:check": "node ./scripts/build_course_contextual_examples.js --check",
    "course:provenance:check": "node ./scripts/course_source_provenance_check.js",
    "course:payloads:build": "node ./scripts/build_course_chapter_payloads.js",
    "course:payloads:check": "node ./scripts/build_course_chapter_payloads.js --check",
    "course:payloads:budget": "node ./scripts/course_payload_budget_check.js",
    "course:graph:check": "node ./scripts/course_build_graph_check.js",
    "course:build": "npm run course:bindings:build && npm run course:examples:build && npm run course:assessments:build && npm run course:verbs:build && npm run course:payloads:build",
    "course:quality": "node ./scripts/course_content_quality_check.js",
    "course:lint": "npm run course:graph:check && npm run course:provenance:check && npm run course:examples:check && npm run course:supplements:check && npm run course:assessments:check && npm run course:bindings:check && npm run course:verbs:check && npm run course:payloads:check && npm run course:payloads:budget && npm run course:quality && node ./scripts/course_lint.js",
    "links:lint": "node ./scripts/links_lint.js",
    "functional:test": "node ./scripts/functional_check.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github-jq:javaquasar/malti-notes.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.59.1",
    "pngjs": "^7.0.0"
  }
}
